{
  "$description": "Generated by the build script from tokens/*.tokens.json. Do not edit.",
  "$extensions": {"org.example.build": {"generator": "build-tokens", "version": "4.2.0"}},
  "color": {
    "neutral": {
      "0": {"$type": "color", "$value": "#ffffff", "$extensions": {"org.example.build": {"source": "primitives.tokens.json"}}},
      "950": {"$type": "color", "$value": "#0c0a09", "$extensions": {"org.example.build": {"source": "primitives.tokens.json"}}}
    },
    "brand": {
      "500": {"$type": "color", "$value": "oklch(62.3% 0.214 259.815)"},
      "500-rgb": {"$type": "color", "$value": "rgb(43 127 255)"}
    }
  },
  "bg": {
    "canvas": {"$type": "color", "$value": "#ffffff"}
  },
  "accent": {"$type": "color", "$value": "#2b7fff"},
  "space": {
    "2": {"$type": "dimension", "$value": "8px"},
    "4": {"$type": "dimension", "$value": "1rem"},
    "gutter": {"$type": "dimension", "$value": "clamp(1rem, 4vw, 2rem)"}
  },
  "radius": {
    "full": {"$type": "dimension", "$value": "9999px"},
    "pill": {"$type": "dimension", "$value": "50%"}
  },
  "font": {
    "family": {
      "sans": {"$type": "fontFamily", "$value": "Inter, system-ui, sans-serif"}
    },
    "weight": {
      "bold": {"$type": "fontWeight", "$value": "700"}
    }
  },
  "duration": {
    "base": {"$type": "duration", "$value": "200ms"},
    "slow": {"$type": "duration", "$value": "0.4s"}
  },
  "easing": {
    "standard": {"$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)"}
  },
  "body": {
    "$type": "typography",
    "$value": {
      "fontFamily": "Inter, system-ui, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "letterSpacing": "0px",
      "lineHeight": 1.5
    }
  }
}
