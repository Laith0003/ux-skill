{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Primitives: raw scales. Components never reference these directly.",
  "color": {
    "$type": "color",
    "$description": "Brand and neutral ramps.",
    "neutral": {
      "0": {"$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}},
      "50": {"$value": {"colorSpace": "srgb", "components": [0.9804, 0.9804, 0.9765], "hex": "#fafaf9"}},
      "200": {"$value": {"colorSpace": "srgb", "components": [0.9059, 0.898, 0.8941], "hex": "#e7e5e4"}},
      "500": {"$value": {"colorSpace": "srgb", "components": [0.4706, 0.4431, 0.4235], "hex": "#78716c"}},
      "800": {"$value": {"colorSpace": "srgb", "components": [0.1608, 0.1451, 0.1412], "hex": "#292524"}},
      "950": {"$value": {"colorSpace": "srgb", "components": [0.0471, 0.0392, 0.0353], "hex": "#0c0a09"}}
    },
    "brand": {
      "$description": "Written in oklch by the design tool; the vivid steps sit outside sRGB.",
      "300": {"$value": {"colorSpace": "oklch", "components": [0.809, 0.105, 251.813]}},
      "500": {"$value": {"colorSpace": "oklch", "components": [0.623, 0.214, 259.815], "hex": "#2b7fff"}},
      "700": {"$value": {"colorSpace": "oklch", "components": [0.488, 0.243, 264.376], "hex": "#1447e6"}}
    },
    "danger": {
      "500": {"$value": {"colorSpace": "oklch", "components": [0.637, 0.237, 25.331]}},
      "700": {"$value": {"colorSpace": "oklch", "components": [0.505, 0.213, 27.518]}}
    },
    "success": {
      "600": {"$value": {"colorSpace": "display-p3", "components": [0.2, 0.62, 0.32], "hex": "#00a63e"}}
    },
    "overlay": {"$value": {"colorSpace": "srgb", "components": [0.0471, 0.0392, 0.0353], "alpha": 0.6}}
  },
  "space": {
    "$type": "dimension",
    "0": {"$value": {"value": 0, "unit": "px"}},
    "1": {"$value": {"value": 4, "unit": "px"}},
    "2": {"$value": {"value": 8, "unit": "px"}},
    "3": {"$value": {"value": 12, "unit": "px"}},
    "4": {"$value": {"value": 16, "unit": "px"}},
    "6": {"$value": {"value": 24, "unit": "px"}},
    "8": {"$value": {"value": 2, "unit": "rem"}}
  },
  "radius": {
    "$type": "dimension",
    "sm": {"$value": {"value": 4, "unit": "px"}},
    "md": {"$value": {"value": 8, "unit": "px"}},
    "full": {"$value": {"value": 9999, "unit": "px"}}
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {"$value": ["Inter", "system-ui", "sans-serif"]},
      "mono": {"$value": ["JetBrains Mono", "monospace"]}
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {"$value": "regular"},
      "medium": {"$value": 500},
      "bold": {"$value": "bold"}
    },
    "size": {
      "$type": "dimension",
      "sm": {"$value": {"value": 0.875, "unit": "rem"}},
      "md": {"$value": {"value": 1, "unit": "rem"}},
      "lg": {"$value": {"value": 1.25, "unit": "rem"}},
      "xl": {"$value": {"value": 2, "unit": "rem"}}
    },
    "tracking": {
      "$type": "dimension",
      "tight": {"$value": {"value": -0.02, "unit": "em"}},
      "normal": {"$value": {"value": 0, "unit": "px"}}
    },
    "leading": {
      "$type": "number",
      "tight": {"$value": 1.2},
      "body": {"$value": 1.5}
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {"$value": {"value": 120, "unit": "ms"}},
    "base": {"$value": {"value": 200, "unit": "ms"}}
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {"$value": [0.2, 0, 0, 1]},
    "emphasized": {"$value": [0.3, 0, 0, 1], "$deprecated": "use easing.standard"}
  }
}
