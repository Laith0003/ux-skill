{
  "$description": "Fixture client system for tests. Neutral names, invented values.",
  "color": {
    "$type": "color",
    "harbor": {
      "400": {
        "$value": "#4A8CE8"
      },
      "500": {
        "$value": "#1C64D9"
      },
      "600": {
        "$value": "#1551B3"
      }
    },
    "slate": {
      "0": {
        "$value": "#FFFFFF"
      },
      "50": {
        "$value": "#F4F6F9"
      },
      "900": {
        "$value": "#1E2329"
      }
    },
    "signal": {
      "500": {
        "$value": "#D6263B"
      }
    }
  },
  "promo": {
    "$type": "color",
    "sale": {
      "fg": {
        "$value": "#C8102E"
      },
      "bg": {
        "$value": "#FDE7EA"
      }
    }
  },
  "brand": {
    "$type": "color",
    "primary": {
      "$value": "{color.harbor.500}"
    },
    "primary-hover": {
      "$value": "{color.harbor.600}"
    },
    "primary-on": {
      "$value": "{color.slate.0}"
    },
    "canvas": {
      "$value": "{color.slate.50}"
    },
    "danger": {
      "$value": "{color.signal.500}"
    },
    "text": {
      "default": {
        "$value": "{color.slate.900}"
      },
      "on-primary": {
        "$value": "{color.slate.0}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": [
          "Fixture Sans",
          "system-ui",
          "sans-serif"
        ]
      }
    }
  },
  "letter-spacing": {
    "$type": "dimension",
    "label": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  }
}
