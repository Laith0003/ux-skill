{
  "brand": {
    "$type": "color",
    "canvas": { "$value": "#FBFAF7" },
    "surface": { "$value": "#FFFFFF" },
    "text-primary": { "$value": "#1B1F24" },
    "text-secondary": { "$value": "#5A6270" },
    "hairline": { "$value": "#E3E1DC" },
    "primary": { "$value": "#0B5F4A" },
    "on-primary": { "$value": "#FFFFFF" },
    "focus": { "$value": "#1F6FEB" }
  },
  "status": {
    "$type": "color",
    "success": { "$value": "#1E7B45" },
    "warning": { "$value": "#8A5A00" },
    "danger": { "$value": "#B3261E" }
  },
  "type": {
    "family-display": { "$type": "fontFamily", "$value": ["Newsreader", "Georgia", "serif"] },
    "family-body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "family-data": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] },
    "size-body": { "$type": "dimension", "$value": "16px" },
    "size-lead": { "$type": "dimension", "$value": "20px" },
    "size-display": { "$type": "dimension", "$value": "56px" }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": "150ms" },
    "duration-base": { "$type": "duration", "$value": "240ms" }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "4px" },
    "medium": { "$type": "dimension", "$value": "8px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "layout": {
    "breakpoint-md": { "$type": "dimension", "$value": "768px" },
    "breakpoint-lg": { "$type": "dimension", "$value": "1024px" }
  }
}
